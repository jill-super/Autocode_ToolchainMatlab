---
// Rendered architecture diagram. Inline SVG, theme-aware via Starlight CSS
// variables, scales to any screen size. No external assets.
const boxFill = 'var(--sl-color-gray-6)';
const boxStroke = 'var(--sl-color-accent)';
const textMain = 'var(--sl-color-gray-1)';
const textSub = 'var(--sl-color-gray-3)';
const arrow = 'var(--sl-color-gray-3)';
---

<svg class="diagram" viewBox="0 0 660 440" role="img" aria-label="Architecture diagram: Simulink model on top, data management and reusable libraries in the middle, design tools and testing tools at the bottom, with the dictionary flowing from design to testing">
  <defs>
    <marker id="arch-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 1 L 9 5 L 0 9 z" style={`fill: ${arrow}`}></path>
    </marker>
  </defs>

  <!-- Top: model -->
  <g>
    <rect x="180" y="8" width="300" height="64" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="330" y="35" text-anchor="middle" font-size="14" font-weight="600" style={`fill: ${textMain}`}>Simulink model</text>
    <text x="330" y="56" text-anchor="middle" font-size="12" style={`fill: ${textSub}`}>FDD subsystem + test harness</text>
  </g>

  <!-- Middle row -->
  <g>
    <rect x="20" y="122" width="300" height="76" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="170" y="150" text-anchor="middle" font-size="14" font-weight="600" style={`fill: ${textMain}`}>Data management</text>
    <text x="170" y="171" text-anchor="middle" font-size="12" style={`fill: ${textSub}`}>DataDict.* · bt.* · dt.* · helpers</text>
    <text x="170" y="188" text-anchor="middle" font-size="11" font-style="italic" style={`fill: ${textSub}`}>the contract language</text>
  </g>
  <g>
    <rect x="340" y="122" width="300" height="76" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="490" y="150" text-anchor="middle" font-size="14" font-weight="600" style={`fill: ${textMain}`}>Reusable libraries</text>
    <text x="490" y="171" text-anchor="middle" font-size="12" style={`fill: ${textSub}`}>EA3 · EA4 · NVM · DevLib</text>
    <text x="490" y="188" text-anchor="middle" font-size="11" font-style="italic" style={`fill: ${textSub}`}>the building blocks</text>
  </g>

  <!-- Bottom row -->
  <g>
    <rect x="20" y="248" width="300" height="76" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="170" y="276" text-anchor="middle" font-size="14" font-weight="600" style={`fill: ${textMain}`}>Design tools</text>
    <text x="170" y="297" text-anchor="middle" font-size="12" style={`fill: ${textSub}`}>CreateDD · VerifyDD · STool · reports</text>
    <text x="170" y="314" text-anchor="middle" font-size="11" font-style="italic" style={`fill: ${textSub}`}>produce + prove the contract</text>
  </g>
  <g>
    <rect x="340" y="248" width="300" height="76" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="490" y="276" text-anchor="middle" font-size="14" font-weight="600" style={`fill: ${textMain}`}>Testing tools</text>
    <text x="490" y="297" text-anchor="middle" font-size="12" style={`fill: ${textSub}`}>MIL · Run_SIL · TD tools · reports</text>
    <text x="490" y="314" text-anchor="middle" font-size="11" font-style="italic" style={`fill: ${textSub}`}>consume + validate it</text>
  </g>

  <!-- Arrows -->
  <line x1="270" y1="72" x2="200" y2="116" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#arch-arrow)" />
  <line x1="390" y1="72" x2="460" y2="116" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#arch-arrow)" />
  <line x1="170" y1="198" x2="170" y2="242" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#arch-arrow)" />
  <line x1="490" y1="198" x2="490" y2="242" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#arch-arrow)" />
  <line x1="320" y1="286" x2="334" y2="286" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#arch-arrow)" />
  <text x="327" y="278" text-anchor="middle" font-size="10" style={`fill: ${textSub}`}>dictionary feeds validation</text>

  <!-- Caption -->
  <g>
    <rect x="20" y="352" width="620" height="64" rx="12" style={`fill: none; stroke: ${arrow}; stroke-width: 1; stroke-dasharray: 6 4`} />
    <text x="330" y="378" text-anchor="middle" font-size="12" style={`fill: ${textMain}`}>The dictionary is the contract between design and test.</text>
    <text x="330" y="397" text-anchor="middle" font-size="12" style={`fill: ${textSub}`}>Design tools produce and check it · testing tools consume it.</text>
  </g>
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    margin: 1rem 0;
  }
  .diagram text {
    font-family: inherit;
  }
</style>
