---
// Rendered STool design-package flow. Inline SVG, theme-aware, responsive.
const boxFill = 'var(--sl-color-gray-6)';
const boxStroke = 'var(--sl-color-accent)';
const textMain = 'var(--sl-color-gray-1)';
const textSub = 'var(--sl-color-gray-3)';
const arrow = 'var(--sl-color-gray-3)';
---

<svg class="diagram" viewBox="0 0 700 340" role="img" aria-label="STool package flow: FDD model, dictionary and setup file go into the STool hub, which produces a regenerated dictionary, verification report, requirements report, Model Advisor report, web views and a delivery folder">
  <defs>
    <marker id="pkg-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 1 L 9 5 L 0 9 z" style={`fill: ${arrow}`}></path>
    </marker>
  </defs>

  <text x="100" y="18" text-anchor="middle" font-size="11" font-weight="600" style={`fill: ${textSub}`}>INPUTS</text>
  <text x="350" y="18" text-anchor="middle" font-size="11" font-weight="600" style={`fill: ${textSub}`}>HUB</text>
  <text x="585" y="18" text-anchor="middle" font-size="11" font-weight="600" style={`fill: ${textSub}`}>ARTIFACTS</text>

  <g>
    <rect x="10" y="30" width="180" height="56" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="100" y="53" text-anchor="middle" font-size="13" font-weight="600" style={`fill: ${textMain}`}>FDD model</text>
    <text x="100" y="71" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>Simulink subsystem</text>
  </g>
  <g>
    <rect x="10" y="102" width="180" height="56" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="100" y="125" text-anchor="middle" font-size="13" font-weight="600" style={`fill: ${textMain}`}>Data dictionary</text>
    <text x="100" y="143" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>component .m file</text>
  </g>
  <g>
    <rect x="10" y="174" width="180" height="56" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="100" y="197" text-anchor="middle" font-size="13" font-weight="600" style={`fill: ${textMain}`}>Simulation setup</text>
    <text x="100" y="215" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>optional setup file</text>
  </g>
  <g>
    <rect x="10" y="246" width="180" height="56" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="100" y="269" text-anchor="middle" font-size="13" font-weight="600" style={`fill: ${textMain}`}>Requirements</text>
    <text x="100" y="287" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>linked source data</text>
  </g>

  <g>
    <rect x="255" y="30" width="190" height="272" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 2`} />
    <text x="350" y="150" text-anchor="middle" font-size="18" font-weight="700" style={`fill: ${textMain}`}>STool</text>
    <text x="350" y="172" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>guided design-package flow</text>
    <text x="350" y="190" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>checks out toolboxes,</text>
    <text x="350" y="206" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>runs generators,</text>
    <text x="350" y="222" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>cleans up via FileMgr</text>
  </g>

  <g>
    <rect x="480" y="30" width="210" height="46" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="585" y="58" text-anchor="middle" font-size="12" font-weight="600" style={`fill: ${textMain}`}>Regenerated dictionary</text>
  </g>
  <g>
    <rect x="480" y="86" width="210" height="46" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="585" y="114" text-anchor="middle" font-size="12" font-weight="600" style={`fill: ${textMain}`}>Verification report</text>
  </g>
  <g>
    <rect x="480" y="142" width="210" height="46" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="585" y="170" text-anchor="middle" font-size="12" font-weight="600" style={`fill: ${textMain}`}>Requirements report</text>
  </g>
  <g>
    <rect x="480" y="198" width="210" height="46" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="585" y="226" text-anchor="middle" font-size="12" font-weight="600" style={`fill: ${textMain}`}>Model Advisor report</text>
  </g>
  <g>
    <rect x="480" y="254" width="210" height="48" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="585" y="274" text-anchor="middle" font-size="12" font-weight="600" style={`fill: ${textMain}`}>Web views + delivery folder</text>
    <text x="585" y="291" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>via NxtrPckGen</text>
  </g>

  <line x1="190" y1="58" x2="249" y2="100" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#pkg-arrow)" />
  <line x1="190" y1="130" x2="249" y2="145" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#pkg-arrow)" />
  <line x1="190" y1="202" x2="249" y2="190" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#pkg-arrow)" />
  <line x1="190" y1="274" x2="249" y2="235" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#pkg-arrow)" />

  <line x1="445" y1="100" x2="474" y2="60" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#pkg-arrow)" />
  <line x1="445" y1="135" x2="474" y2="112" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#pkg-arrow)" />
  <line x1="445" y1="166" x2="474" y2="165" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#pkg-arrow)" />
  <line x1="445" y1="197" x2="474" y2="218" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#pkg-arrow)" />
  <line x1="445" y1="232" x2="474" y2="272" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#pkg-arrow)" />
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    margin: 1rem 0;
  }
  .diagram text {
    font-family: inherit;
  }
</style>
