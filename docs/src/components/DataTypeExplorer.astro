const families = ['All', 'signed', 'unsigned', 'mixed', 'float', 'binary', 'logic'];
---

<div data-dt-explorer>
  <input class="searchbox" type="search" placeholder="Filter types — try “16”, “fixdt(1,32”, “sint8”…" aria-label="Filter data types" data-search />
  <div class="pill-row" data-pills>
    {families.map((f) => (
      <button class="pill" data-family={f} aria-pressed={f === 'All' ? 'true' : 'false'}>{f}</button>
    ))}
  </div>
  <p data-count aria-live="polite"></p>
  <div style="overflow-x: auto">
    <table class="docs-table" data-table>
      <thead><tr><th>Type</th><th>Family</th><th>Base class</th><th>Meaning</th></tr></thead>
      <tbody>
        {types.map((t) => (
          <tr data-name={t.name.toLowerCase()} data-family={t.family} data-hay={`${t.name} ${t.parent} ${t.desc}`.toLowerCase()}>
            <td><code>dt.{t.name}</code></td>
            <td>{t.family}</td>
            <td><code>{t.parent}</code></td>
            <td>{t.desc || '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  (() => {
    const root = document.querySelector('[data-dt-explorer]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const search = root.querySelector('[data-search]');
    const rows = [...root.querySelectorAll('tbody tr')];
    const count = root.querySelector('[data-count]');
    let family = 'All';
    const apply = () => {
      const q = search.value.trim().toLowerCase();
      let n = 0;
      for (const r of rows) {
        const ok =
          (family === 'All' || r.dataset.family === family) &&
          (!q || r.dataset.hay.includes(q));
        r.style.display = ok ? '' : 'none';
        if (ok) n++;
      }
      count.textContent = `${n} of ${rows.length} types shown`;
    };
    root.querySelector('[data-pills]').addEventListener('click', (e) => {
      const b = e.target.closest('[data-family]');
      if (!b) return;
      family = b.dataset.family;
      root.querySelectorAll('[data-pills] .pill').forEach((p) =>
        p.setAttribute('aria-pressed', String(p === b)),
      );
      apply();
    });
    search.addEventListener('input', apply);
    apply();
  })();
</script>
