---
// Rendered end-to-end pipeline strip (6 stages). Inline SVG, theme-aware.
const boxFill = 'var(--sl-color-gray-6)';
const boxStroke = 'var(--sl-color-accent)';
const textMain = 'var(--sl-color-gray-1)';
const textSub = 'var(--sl-color-gray-3)';
const arrow = 'var(--sl-color-gray-3)';
const stages = [
  { title: 'Model', sub: 'Simulink' },
  { title: 'Declare', sub: 'DataDict' },
  { title: 'CreateDD', sub: '.m dict' },
  { title: 'VerifyDD', sub: 'checks' },
  { title: 'STool', sub: 'package' },
  { title: 'MIL · SIL', sub: 'validate' },
];
const w = 96;
const gap = 16;
const x0 = 8;
---

<svg class="diagram" viewBox="0 0 680 110" role="img" aria-label="End-to-end pipeline: Model, Declare, CreateDD, VerifyDD, STool, then MIL and SIL validation">
  {stages.map((s, i) => {
    const x = x0 + i * (w + gap);
    return (
      <g>
        <rect x={x} y="18" width={w} height="72" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
        <text x={x + w / 2} y="40" text-anchor="middle" font-size="10" font-weight="700" style={`fill: ${textSub}`}>{`STEP ${i + 1}`}</text>
        <text x={x + w / 2} y="60" text-anchor="middle" font-size="13" font-weight="600" style={`fill: ${textMain}`}>{s.title}</text>
        <text x={x + w / 2} y="78" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>{s.sub}</text>
        {i < stages.length - 1 && (
          <g>
            <line x1={x + w} y1="54" x2={x + w + gap - 2} y2="54" style={`stroke: ${arrow}; stroke-width: 1.5`} />
            <path d={`M ${x + w + gap - 8} 49 L ${x + w + gap - 1} 54 L ${x + w + gap - 8} 59 z`} style={`fill: ${arrow}`} />
          </g>
        )}
      </g>
    );
  })}
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    margin: 1rem 0;
  }
  .diagram text {
    font-family: inherit;
  }
</style>
