---
// Rendered MIL workflow diagram. Inline SVG, theme-aware, responsive.
const boxFill = 'var(--sl-color-gray-6)';
const boxStroke = 'var(--sl-color-accent)';
const textMain = 'var(--sl-color-gray-1)';
const textSub = 'var(--sl-color-gray-3)';
const arrow = 'var(--sl-color-gray-3)';
---

<svg class="diagram" viewBox="0 0 660 380" role="img" aria-label="MIL workflow: the MIL GUI splits into Normal mode and Batch mode, both feeding plots, reports and a delivery folder">
  <defs>
    <marker id="mil-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 1 L 9 5 L 0 9 z" style={`fill: ${arrow}`}></path>
    </marker>
  </defs>

  <g>
    <rect x="230" y="8" width="200" height="60" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 2`} />
    <text x="330" y="33" text-anchor="middle" font-size="16" font-weight="700" style={`fill: ${textMain}`}>MIL GUI</text>
    <text x="330" y="52" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>gated by TD checks first</text>
  </g>

  <g>
    <rect x="20" y="108" width="300" height="104" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="170" y="134" text-anchor="middle" font-size="14" font-weight="600" style={`fill: ${textMain}`}>Normal mode</text>
    <text x="170" y="155" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>plan development: add a case,</text>
    <text x="170" y="171" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>run it, analyze, iterate</text>
    <text x="170" y="187" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>final: one FDD, options preset</text>
  </g>
  <g>
    <rect x="340" y="108" width="300" height="104" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="490" y="134" text-anchor="middle" font-size="14" font-weight="600" style={`fill: ${textMain}`}>Batch mode</text>
    <text x="490" y="155" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>final validation for many FDDs</text>
    <text x="490" y="171" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>records errors, continues</text>
    <text x="490" y="187" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>dated log + delivery folder</text>
  </g>

  <line x1="280" y1="68" x2="200" y2="102" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#mil-arrow)" />
  <line x1="380" y1="68" x2="460" y2="102" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#mil-arrow)" />

  <line x1="170" y1="212" x2="170" y2="242" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#mil-arrow)" />
  <line x1="490" y1="212" x2="490" y2="242" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#mil-arrow)" />
  <line x1="60" y1="248" x2="600" y2="248" style={`stroke: ${arrow}; stroke-width: 1.5`} />
  <line x1="125" y1="248" x2="125" y2="276" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#mil-arrow)" />
  <line x1="330" y1="248" x2="330" y2="276" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#mil-arrow)" />
  <line x1="535" y1="248" x2="535" y2="276" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#mil-arrow)" />

  <g>
    <rect x="30" y="282" width="190" height="72" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="125" y="309" text-anchor="middle" font-size="13" font-weight="600" style={`fill: ${textMain}`}>Plots</text>
    <text x="125" y="328" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>per-case result figures</text>
  </g>
  <g>
    <rect x="235" y="282" width="190" height="72" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="330" y="309" text-anchor="middle" font-size="13" font-weight="600" style={`fill: ${textMain}`}>Reports</text>
    <text x="330" y="328" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>verification + inspection</text>
  </g>
  <g>
    <rect x="440" y="282" width="190" height="72" rx="12" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="535" y="309" text-anchor="middle" font-size="13" font-weight="600" style={`fill: ${textMain}`}>Delivery folder</text>
    <text x="535" y="328" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>named per FDD / run date</text>
  </g>
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    margin: 1rem 0;
  }
  .diagram text {
    font-family: inherit;
  }
</style>
