  { name: 'NxtrXlsRead', area: 'Design', kind: 'Keyword', summary: 'Read keyword/abbreviation Excel lists (abbreviations, exclusion list).' },
  { name: 'NxtrToolsPahFindr', area: 'Design', kind: 'Infra', summary: 'Locate the tools path on the MATLAB search path.' },
  { name: 'NxtrToolsVersFindr', area: 'Design', kind: 'Infra', summary: 'Resolve the latest available tools version.' },
  { name: 'NxtrLicChkOut', area: 'Design', kind: 'Infra', summary: 'Check out the toolboxes needed for the design package.' },
  { name: 'NxtrLnchDoors', area: 'Design', kind: 'Traceability', summary: 'Launch/hook for the requirements-management tool.' },
  { name: 'NxtrUpdRpt', area: 'Design', kind: 'Report', summary: 'Update-report helper used inside package generation.' },
  { name: 'NxtrWebViewGenr', area: 'Design', kind: 'Report', summary: 'Web-view generation helper for model reports.' },
  // ---- Testing tools ----
  { name: 'MIL', area: 'Testing', kind: 'Validation', summary: 'GUI for MIL validation in Normal mode (plan development, final) and Batch mode.' },
  { name: 'Run_MIL', area: 'Testing', kind: 'Validation', summary: 'Deprecated stub — use MIL for Model-In-the-Loop validation.' },
  { name: 'Run_SIL', area: 'Testing', kind: 'Validation', summary: 'Run SIL from a test-definition file plus a SIL harness.' },
  { name: 'MakeTestCals', area: 'Testing', kind: 'Test setup', summary: 'Create a unit-test-plan parameter-file template from dictionary file(s).' },
  { name: 'CreateLCTFiles', area: 'Testing', kind: 'Test setup', summary: 'Create LCT interface files (e.g. calibration headers) from dictionaries.' },
  { name: 'NxtrTDMgr', area: 'Testing', kind: 'Test setup', summary: 'Orchestrate test-definition parsing and verification tools.' },
