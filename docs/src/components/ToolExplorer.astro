  { name: 'NxtrSigFindr', area: 'Testing', kind: 'Search', summary: 'Signal finder helper for test/report flows.' },
  { name: 'NxtrKeyWrdFindr', area: 'Testing', kind: 'Search', summary: 'Keyword finder helper for test/report flows.' },
