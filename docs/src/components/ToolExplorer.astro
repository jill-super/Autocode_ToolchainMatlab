  { name: 'NxtrDDRprtGenr', area: 'Design', kind: 'Report', summary: 'Auto-create a dictionary verification report for the design package.' },
  { name: 'NxtrDTMgr', area: 'Design', kind: 'Datatype', summary: 'Validate a user data type against the approved tools list.' },
  { name: 'NxtrDTTbl', area: 'Design', kind: 'Datatype', summary: 'The approved user-defined datatype table used across programs.' },
