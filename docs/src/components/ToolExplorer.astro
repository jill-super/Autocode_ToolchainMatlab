  { name: 'NxtrKeyWrdMgr', area: 'Design', kind: 'Keyword', summary: 'Collect unknown keywords used inside a signal or parameter name.' },
  { name: 'NxtrKeyWrdRpt', area: 'Design', kind: 'Keyword', summary: 'Report a name against the unknown-keyword list during dictionary creation.' },
  { name: 'NxtrAbbListBldr', area: 'Design', kind: 'Keyword', summary: 'Build the abbreviation list that backs keyword checking.' },
  { name: 'NxtrFindFDDMdl', area: 'Design', kind: 'Discovery', summary: 'Find the FDD model plus its dictionary and simulation setup files.' },
  { name: 'NxtrChkFDDData', area: 'Design', kind: 'Discovery', summary: 'Report which FDDs have their required artifacts present.' },
  { name: 'NxtrFDDNoNmeGenr', area: 'Design', kind: 'Discovery', summary: 'Generate FDD number/name metadata.' },
  { name: 'NxtrElecArchTypFindr', area: 'Design', kind: 'Discovery', summary: 'Detect the electrical-architecture type (EA3/EA4).' },
  { name: 'NxtrFileMgr', area: 'Design', kind: 'Packaging', summary: 'Track newly generated files and remove intermediate clutter.' },
  { name: 'NxtrPckGen', area: 'Design', kind: 'Packaging', summary: 'Assemble Design or MIL setup folders with all required artifacts.' },
