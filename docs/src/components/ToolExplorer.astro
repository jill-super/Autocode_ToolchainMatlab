  { name: 'NxtrSumryTblGenr', area: 'Testing', kind: 'Report', summary: 'Generate summary tables for reports.' },
  { name: 'NxtrTCRGenr', area: 'Testing', kind: 'Report', summary: 'Generate the test-completion record content.' },
  { name: 'NxtrWrdRprtGenr', area: 'Testing', kind: 'Report', summary: 'Generate Word-format reports.' },
  { name: 'NxtrAddTbl', area: 'Testing', kind: 'Report', summary: 'Add tables to generated reports.' },
  { name: 'NxtrAddHLinks', area: 'Testing', kind: 'Report', summary: 'Add hyperlinks to generated reports.' },
  { name: 'NxtrAddTags', area: 'Testing', kind: 'Report', summary: 'Add tags to generated reports.' },
  { name: 'NxtrTblDataUpdr', area: 'Testing', kind: 'Report', summary: 'Update table data inside reports.' },
  { name: 'NxtrXlsWrite', area: 'Testing', kind: 'Report', summary: 'Write FDD model info to Excel files.' },
  { name: 'NxtrReqAnlyzr', area: 'Testing', kind: 'Report', summary: 'Requirements-analysis helper for the test flow.' },
  { name: 'PlotSimData', area: 'Testing', kind: 'Analysis', summary: 'Plot unit-test simulation data per test case.' },
  { name: 'SaveSimData', area: 'Testing', kind: 'Analysis', summary: 'Save simulation input/output vectors to data files.' },
  { name: 'simulink2doors', area: 'Testing', kind: 'Traceability', summary: 'Export design-model links to CSV for import into the requirements tool.' },
  { name: 'testdef2doors', area: 'Testing', kind: 'Traceability', summary: 'Export test-definition links to CSV for import into the requirements tool.' },
  { name: 'NxtrPrevFileDel', area: 'Testing', kind: 'Infra', summary: 'Delete previous-run files before a fresh validation.' },
];

const kinds = ['All', ...new Set(tools.map((t) => t.kind))].sort((a, b) =>
  a === 'All' ? -1 : b === 'All' ? 1 : a.localeCompare(b),
);
---

<div class="tool-explorer" data-tool-explorer>
  <input class="searchbox" type="search" placeholder="Filter tools — try “report”, “keyword”, “MIL”…" aria-label="Filter tools" data-search />
  <div class="pill-row" data-pills>
    <button class="pill" data-area="All" aria-pressed="true">All</button>
    <button class="pill" data-area="Design" aria-pressed="false">Design</button>
    <button class="pill" data-area="Testing" aria-pressed="false">Testing</button>
  </div>
  <div class="pill-row" data-kind-pills>
    {kinds.map((k) => (
      <button class="pill" data-kind={k} aria-pressed={k === 'All' ? 'true' : 'false'}>{k}</button>
    ))}
  </div>
  <p data-count aria-live="polite"></p>
  <div class="tool-grid" data-grid>
    {tools.map((t) => (
      <article class="tool-card" data-name={t.name.toLowerCase()} data-area={t.area} data-kind={t.kind} data-summary={t.summary.toLowerCase()}>
        <h3><code>{t.name}</code></h3>
        <p>{t.summary}</p>
        <p><span class="pill">{t.area}</span> <span class="pill">{t.kind}</span></p>
      </article>
    ))}
  </div>
</div>

<script>
  (() => {
    const root = document.querySelector('[data-tool-explorer]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const search = root.querySelector('[data-search]');
    const grid = root.querySelector('[data-grid]');
    const count = root.querySelector('[data-count]');
    const cards = [...grid.querySelectorAll('.tool-card')];
    let area = 'All';
    let kind = 'All';
    const apply = () => {
      const q = search.value.trim().toLowerCase();
      let n = 0;
      for (const c of cards) {
        const ok =
          (area === 'All' || c.dataset.area === area) &&
          (kind === 'All' || c.dataset.kind === kind) &&
          (!q || c.dataset.name.includes(q) || c.dataset.summary.includes(q));
        c.style.display = ok ? '' : 'none';
        if (ok) n++;
      }
      count.textContent = `${n} of ${cards.length} tools shown`;
    };
    root.querySelector('[data-pills]').addEventListener('click', (e) => {
      const b = e.target.closest('[data-area]');
      if (!b) return;
      area = b.dataset.area;
      root.querySelectorAll('[data-pills] .pill').forEach((p) =>
        p.setAttribute('aria-pressed', String(p === b)),
      );
      apply();
    });
    root.querySelector('[data-kind-pills]').addEventListener('click', (e) => {
      const b = e.target.closest('[data-kind]');
      if (!b) return;
      kind = b.dataset.kind;
      root.querySelectorAll('[data-kind-pills] .pill').forEach((p) =>
        p.setAttribute('aria-pressed', String(p === b)),
      );
      apply();
    });
    search.addEventListener('input', apply);
    apply();
  })();
</script>
