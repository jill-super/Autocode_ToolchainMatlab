---
// Rendered helper/text-generation loop. Inline SVG, theme-aware, responsive.
const boxFill = 'var(--sl-color-gray-6)';
const boxStroke = 'var(--sl-color-accent)';
const textMain = 'var(--sl-color-gray-1)';
const textSub = 'var(--sl-color-gray-3)';
const arrow = 'var(--sl-color-gray-3)';
---

<svg class="diagram" viewBox="0 0 660 235" role="img" aria-label="Text generation loop: DataDict objects render through String methods and helpers into dictionary files, which VerifyDD re-parses; fixes go into the helpers, never into hand-edits">
  <defs>
    <marker id="help-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 1 L 9 5 L 0 9 z" style={`fill: ${arrow}`}></path>
    </marker>
  </defs>

  <g>
    <rect x="8" y="14" width="150" height="64" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="83" y="41" text-anchor="middle" font-size="12" font-weight="600" style={`fill: ${textMain}`}>DataDict object</text>
    <text x="83" y="59" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>value + type</text>
  </g>
  <g>
    <rect x="176" y="14" width="150" height="64" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="251" y="41" text-anchor="middle" font-size="12" font-weight="600" style={`fill: ${textMain}`}>String() method</text>
    <text x="251" y="59" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>per-class rendering</text>
  </g>
  <g>
    <rect x="344" y="14" width="150" height="64" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="419" y="34" text-anchor="middle" font-size="12" font-weight="600" style={`fill: ${textMain}`}>Helpers</text>
    <text x="419" y="51" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>Val2String · MinMax</text>
    <text x="419" y="66" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>WriteDescription</text>
  </g>
  <g>
    <rect x="502" y="14" width="150" height="64" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="577" y="41" text-anchor="middle" font-size="12" font-weight="600" style={`fill: ${textMain}`}>Dictionary .m</text>
    <text x="577" y="59" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>written by CreateDD</text>
  </g>

  <line x1="158" y1="46" x2="170" y2="46" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#help-arrow)" />
  <line x1="326" y1="46" x2="338" y2="46" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#help-arrow)" />
  <line x1="494" y1="46" x2="496" y2="46" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#help-arrow)" />

  <line x1="577" y1="78" x2="577" y2="128" style={`stroke: ${arrow}; stroke-width: 1.5`} marker-end="url(#help-arrow)" />

  <g>
    <rect x="502" y="134" width="150" height="56" rx="10" style={`fill: ${boxFill}; stroke: ${boxStroke}; stroke-width: 1.5`} />
    <text x="577" y="157" text-anchor="middle" font-size="12" font-weight="600" style={`fill: ${textMain}`}>VerifyDD</text>
    <text x="577" y="175" text-anchor="middle" font-size="11" style={`fill: ${textSub}`}>re-parses + checks</text>
  </g>

  <line x1="502" y1="188" x2="40" y2="188" style={`stroke: ${arrow}; stroke-width: 1.5; stroke-dasharray: 6 4`} marker-end="url(#help-arrow)" />
  <line x1="40" y1="188" x2="40" y2="84" style={`stroke: ${arrow}; stroke-width: 1.5; stroke-dasharray: 6 4`} marker-end="url(#help-arrow)" />
  <text x="271" y="208" text-anchor="middle" font-size="11" font-style="italic" style={`fill: ${textSub}`}>wrong text? fix the helpers and regenerate — never hand-edit the file</text>
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    margin: 1rem 0;
  }
  .diagram text {
    font-family: inherit;
  }
</style>
